# Необязательно. Без ключа OpenDota даёт ~60 запросов/мин и ~2000/день бесплатно.
# Ключ: https://www.opendota.com/api-keys
VITE_OPENDOTA_API_KEY=

# Будущее: Stratz GraphQL (точные позиции 1–5, синергии, скилл-билды).
# Токен НЕЛЬЗЯ светить во фронтенде в проде — проксируйте через бэкенд.
# VITE_STRATZ_PROXY_URL=https://your-backend.example.com/stratz
